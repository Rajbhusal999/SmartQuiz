# ====================================================================
# Smart Quiz System - Backend Environment Configuration
# Place your credentials in backend/.env (never commit .env to git)
# ====================================================================

# 1. Supabase Project URL (Project Settings -> API -> Project URL)
SUPABASE_URL=https://your-project-ref.supabase.co

# 2. Supabase Service-Role Secret Key (Project Settings -> API -> service_role secret)
# IMPORTANT: Used ONLY in the backend, NEVER share with frontend/client.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# 3. Supabase Anon/Public Key (Project Settings -> API -> anon public)
SUPABASE_KEY=your-supabase-anon-key

# 4. Supabase JWT Secret (Project Settings -> API -> JWT Settings -> JWT Secret)
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
